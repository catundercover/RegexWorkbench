Grammar

    0 $accept: result $end

    1 result: "LTL start marker" subformula "end of formula"
    2       | "LTL start marker" enderror
    3       | "LTL start marker" subformula enderror
    4       | "LTL start marker" quantifiedformula "end of formula"
    5       | "LTL start marker" quantifiedformula enderror
    6       | "LTL start marker" emptyinput
    7       | "BOOLEAN start marker" boolformula "end of formula"
    8       | "BOOLEAN start marker" enderror
    9       | "BOOLEAN start marker" boolformula enderror
   10       | "BOOLEAN start marker" emptyinput
   11       | "SERE start marker" sere "end of formula"
   12       | "SERE start marker" enderror
   13       | "SERE start marker" sere enderror
   14       | "SERE start marker" emptyinput
   15       | "LBT start marker" lbtformula "end of formula"
   16       | "LBT start marker" enderror
   17       | "LBT start marker" lbtformula enderror
   18       | "LBT start marker" emptyinput

   19 emptyinput: "end of formula"

   20 enderror: error "end of formula"

   21 OP_SQBKT_SEP_unbounded: "separator for square bracket operator"
   22                       | "separator for square bracket operator" "unbounded mark"

   23 OP_SQBKT_SEP_opt: ε
   24                 | OP_SQBKT_SEP_unbounded

   25 error_opt: ε
   26          | error

   27 sqbkt_num: "number for square bracket operator"

   28 sqbracketargs: sqbkt_num "separator for square bracket operator" sqbkt_num "closing bracket"
   29              | sqbkt_num OP_SQBKT_SEP_unbounded "closing bracket"
   30              | "separator for square bracket operator" sqbkt_num "closing bracket"
   31              | OP_SQBKT_SEP_opt "closing bracket"
   32              | sqbkt_num "closing bracket"

   33 gotoargs: "opening bracket for goto operator" sqbkt_num "separator for square bracket operator" sqbkt_num "closing bracket"
   34         | "opening bracket for goto operator" sqbkt_num OP_SQBKT_SEP_unbounded "closing bracket"
   35         | "opening bracket for goto operator" "separator for square bracket operator" sqbkt_num "closing bracket"
   36         | "opening bracket for goto operator" OP_SQBKT_SEP_unbounded "closing bracket"
   37         | "opening bracket for goto operator" "closing bracket"
   38         | "opening bracket for goto operator" sqbkt_num "closing bracket"
   39         | "opening bracket for goto operator" error "closing bracket"
   40         | "opening bracket for goto operator" error_opt "end of formula"

   41 kleen_star: "star operator"
   42           | "bracket star operator"

   43 starargs: kleen_star
   44         | "plus operator"
   45         | "opening bracket for star operator" sqbracketargs
   46         | "opening bracket for star operator" error "closing bracket"
   47         | "opening bracket for star operator" error_opt "end of formula"

   48 fstarargs: "bracket fusion-star operator"
   49          | "fusion-plus operator"
   50          | "opening bracket for fusion-star operator" sqbracketargs
   51          | "opening bracket for fusion-star operator" error "closing bracket"
   52          | "opening bracket for fusion-star operator" error_opt "end of formula"

   53 equalargs: "opening bracket for equal operator" sqbracketargs
   54          | "opening bracket for equal operator" error "closing bracket"
   55          | "opening bracket for equal operator" error_opt "end of formula"

   56 delayargs: "opening bracket for SVA delay operator" sqbracketargs
   57          | "opening bracket for SVA delay operator" error "closing bracket"
   58          | "opening bracket for SVA delay operator" error_opt "end of formula"
   59          | "##[+] operator"
   60          | "##[*] operator"

   61 atomprop: "atomic proposition"

   62 booleanatom: atomprop
   63            | atomprop "positive suffix"
   64            | atomprop "negative suffix"
   65            | "constant true"
   66            | "constant false"

   67 sere: booleanatom
   68     | "not operator" sere
   69     | bracedsere
   70     | "(...) block"
   71     | "opening parenthesis" sere "closing parenthesis"
   72     | "opening parenthesis" error "closing parenthesis"
   73     | "opening parenthesis" sere "end of formula"
   74     | "opening parenthesis" error "end of formula"
   75     | sere "and operator" sere
   76     | sere "and operator" error
   77     | sere "short and operator" sere
   78     | sere "short and operator" error
