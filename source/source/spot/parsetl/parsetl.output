  143 aplist: atomprop
  144       | aplist atomprop
  145       | aplist "," atomprop

  146 maybequantifiedformula: subformula
  147                       | quantifiedformula

  148 exists_or_forall: "exists operator"
  149                 | "forall operator"

  150 quantifiedformula: "exists operator" aplist ":" maybequantifiedformula
  151                  | "forall operator" aplist ":" maybequantifiedformula
  152                  | exists_or_forall error ":" maybequantifiedformula
  153                  | exists_or_forall error_opt "end of formula"

