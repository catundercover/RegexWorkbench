  106           | "opening brace" sere error "closing brace"
  107           | "opening brace" error "closing brace"
  108           | "opening brace" sere "end of formula"
  109           | "opening brace" sere error "end of formula"
  110           | "opening brace" error "end of formula"
  111           | "{...} block"

  112 parenthesedsubformula: "(...) block"
