   82     | sere "concat operator" error
   83     | sere ":" sere
   84     | sere ":" error
   85     | "SVA delay operator" sere
   86     | "SVA delay operator" error
   87     | sere "SVA delay operator" sere
   88     | sere "SVA delay operator" error
   89     | delayargs sere
