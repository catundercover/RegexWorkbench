Grammar

    0 $accept: aut "end of file"

    1 aut: aut-1

    2 $@1: ε

    3 aut: "#line" $@1 aut
    4    | "end of file"
    5    | error "end of file"
    6    | error aut-1

    7 aut-1: hoa
    8      | never
    9      | lbtt
   10      | dstar
   11      | pgame

   12 hoa: header "--BODY--" body "--END--"
   13    | "HOA:" error "--END--"

   14 string_opt: ε
   15           | "string"

   16 BOOLEAN: 't'
   17        | 'f'

   18 header: format-version header-items

   19 version: "identifier"

   20 $@2: ε

   21 format-version: "HOA:" $@2 version

   22 controllable-aps: ε
   23                 | controllable-aps "integer"

   24 $@3: ε

   25 aps: "AP:" "integer" $@3 ap-names

   26 header-items: ε
   27             | header-items header-item

   28 header-item: "States:" "integer"
   29            | "Start:" init-state-conj-2
   30            | "Start:" state-num
   31            | aps
   32            | "controllable-AP:" controllable-aps

   33 $@4: ε

   34 header-item: "Alias:" "alias name" $@4 label-expr

   35 $@5: ε

   36 header-item: "Acceptance:" "integer" $@5 acceptance-cond
   37            | "acc-name:" "identifier" acc-spec
   38            | "tool:" "string" string_opt
   39            | "name:" "string"
   40            | "properties:" properties

   41 $@6: ε

   42 header-item: "spot.highlight.edges:" $@6 highlight-edges

   43 $@7: ε

   44 header-item: "spot.highlight.states:" $@7 highlight-states

   45 $@8: ε

   46 header-item: "spot.state-player:" $@8 state-player
   47            | "header name" header-spec
   48            | error

   49 ap-names: ε
   50         | ap-names ap-name

   51 ap-name: "string"

   52 acc-spec: ε
   53         | acc-spec BOOLEAN
   54         | acc-spec "integer"
   55         | acc-spec "identifier"

   56 properties: ε
   57           | properties "identifier"
   58           | properties '!' "identifier"

   59 highlight-edges: ε
   60                | highlight-edges "integer" "integer"

   61 highlight-states: ε
   62                 | highlight-states "integer" "integer"

   63 state-player: ε
   64             | state-player "integer"

   65 header-spec: ε
   66            | header-spec BOOLEAN
   67            | header-spec "integer"
   68            | header-spec "string"
   69            | header-spec "identifier"

   70 state-conj-2: checked-state-num '&' checked-state-num
   71             | state-conj-2 '&' checked-state-num

   72 init-state-conj-2: state-num '&' state-num
   73                  | init-state-conj-2 '&' state-num

   74 label-expr: 't'
   75           | 'f'
   76           | "integer"
   77           | "alias name"
   78           | '!' label-expr
   79           | label-expr '&' label-expr
   80           | label-expr '|' label-expr
   81           | '(' label-expr ')'

   82 acc-set: "integer"

   83 acceptance-cond: "identifier" '(' acc-set ')'
   84                | "identifier" '(' '!' acc-set ')'
   85                | '(' acceptance-cond ')'
   86                | acceptance-cond '&' acceptance-cond
   87                | acceptance-cond '|' acceptance-cond
   88                | 't'
   89                | 'f'

   90 body: states

   91 state-num: "integer"

   92 checked-state-num: state-num

   93 states: ε
   94       | states state

   95 state: state-name labeled-edges
   96      | state-name unlabeled-edges
   97      | error

   98 state-name: "State:" state-label_opt checked-state-num string_opt state-acc_opt

   99 label: '[' label-expr ']'
  100      | BDD
  101      | '[' error ']'

  102 state-label_opt: ε
  103                | label

  104 trans-label: label

  105 acc-sig: '{' acc-sets '}'
  106        | '{' error '}'

  107 acc-sets: ε
  108         | acc-sets acc-set

  109 state-acc_opt: ε
  110              | acc-sig

  111 trans-acc_opt: ε
  112              | acc-sig

  113 labeled-edges: ε
  114              | some-labeled-edges

  115 some-labeled-edges: labeled-edge
  116                   | some-labeled-edges labeled-edge
  117                   | some-labeled-edges incorrectly-unlabeled-edge

  118 incorrectly-unlabeled-edge: checked-state-num trans-acc_opt

  119 labeled-edge: trans-label checked-state-num trans-acc_opt
  120             | trans-label state-conj-checked trans-acc_opt

  121 state-conj-checked: state-conj-2

  122 unlabeled-edges: unlabeled-edge
  123                | unlabeled-edges unlabeled-edge
  124                | unlabeled-edges incorrectly-labeled-edge

  125 unlabeled-edge: checked-state-num trans-acc_opt
  126               | state-conj-checked trans-acc_opt

  127 incorrectly-labeled-edge: trans-label unlabeled-edge

  128 dstar: dstar_type "v2" "explicit" dstar_header "---" dstar_states "end of DSTAR automaton"
  129      | dstar_type error "end of DSTAR automaton"

  130 dstar_type: "DRA"
  131           | "DSA"

  132 dstar_header: dstar_sizes

  133 dstar_sizes: ε
  134            | dstar_sizes error
  135            | dstar_sizes "Acceptance-Pairs:" "integer"
  136            | dstar_sizes "States:" "integer"
  137            | dstar_sizes "Start:" "integer"
  138            | dstar_sizes aps

  139 dstar_state_id: "State:" "integer" string_opt

  140 sign: '+'
  141     | '-'

  142 dstar_accsigs: ε
  143              | dstar_accsigs sign "integer"

  144 dstar_state_accsig: "Acc-Sig:" dstar_accsigs

  145 dstar_transitions: ε
  146                  | dstar_transitions "integer"

  147 dstar_states: ε
  148             | dstar_states error
  149             | dstar_states dstar_state_id dstar_state_accsig dstar_transitions

  150 pgamestart: "start of PGSolver game"

  151 pgame: pgamestart pgame_nodes "end of PGSolver game"
  152      | pgamestart error "end of PGSolver game"

  153 pgame_nodes: pgame_node ';'
  154            | pgame_nodes pgame_node ';'

  155 pgame_succs: "integer"
  156            | pgame_succs ',' "integer"

  157 pgame_node: "integer" "integer" "integer" pgame_succs string_opt

  158 $@9: ε

  159 never: "never" $@9 '{' nc-states '}'

  160 nc-states: ε
  161          | nc-state
  162          | nc-states ';' nc-state
  163          | nc-states ';'

  164 nc-one-ident: "identifier" ':'

  165 nc-ident-list: nc-one-ident
  166              | nc-ident-list nc-one-ident

  167 nc-transition-block: "if" nc-transitions "fi"
  168                    | "do" nc-transitions "od"

  169 nc-state: nc-ident-list "skip"
  170         | nc-ident-list
  171         | nc-ident-list "false"
  172         | nc-ident-list nc-transition-block

  173 nc-transitions: ε
  174               | nc-transitions nc-transition

  175 nc-formula-or-ident: "boolean formula"
  176                    | "identifier"

  177 nc-formula: nc-formula-or-ident
  178           | "false"

  179 nc-opt-dest: ε
  180            | "->" "goto" "identifier"
  181            | "->" "assert" "boolean formula"

  182 nc-src-dest: nc-formula nc-opt-dest

  183 nc-transition: ':' ':' "atomic" '{' nc-src-dest '}'
  184              | ':' ':' nc-src-dest

  185 lbtt: lbtt-header lbtt-body "-1"
  186     | lbtt-header-states "acceptance sets for empty automaton"

  187 lbtt-header-states: "LBTT header"

  188 lbtt-header: lbtt-header-states "state acceptance"
  189            | lbtt-header-states "integer"

  190 lbtt-body: lbtt-states

  191 lbtt-states: ε
  192            | lbtt-states lbtt-state lbtt-transitions

  193 lbtt-state: "state number" "integer" lbtt-acc

  194 lbtt-acc: ε
  195         | lbtt-acc "acceptance set"

  196 lbtt-guard: "string"

  197 lbtt-transitions: ε
  198                 | lbtt-transitions "destination number" lbtt-acc lbtt-guard


